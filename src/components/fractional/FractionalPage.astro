---
/**
 * The Fractional AI and Systems Lead page, /fractional and its industry versions /fractional/<slug>. A copy of
 * markszymanski.co's /work-with-me (that repo's src/components/WorkWithMe.astro) in Motive11's look,
 * made November 6, 2026 at Mark's request: same sections, order, copy, video, and pricing logic.
 * Prices come from src/lib/pricing.ts, industry wording from src/lib/industries.ts.
 */
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ClientLogos from "../ClientLogos.astro";
import Testimonial from "../Testimonial.astro";
import StoryCard from "./StoryCard.astro";
import { fetchTestimonials } from "../../lib/testimonials";
import { pricing, usd } from "../../lib/pricing";
import { breadcrumb } from "../../lib/schema";
import { site } from "../../lib/site";
import type { Industry } from "../../lib/industries";
import portrait from "../../assets/mark/portrait.webp";

const { industry } = Astro.props as { industry?: Industry };

const services = await fetchTestimonials({ tags: ["Services"], sort: "date", order: "desc", limit: 500 });
const testimonials = services.slice(0, 9);

const cases = (await getCollection("case-studies")).sort((a, b) => a.data.order - b.data.order);
const storyFor = new Map<string, string>();
for (const c of cases) for (const id of c.data.testimonialIds) storyFor.set(id, `/case-studies/${c.id}`);

// Excerpts are verbatim trims of the published testimonial. Never paraphrased or pronoun-edited.
const shefflerQuoteId = "8b67a481-a547-4d8f-a6e1-c4554bb6f0fe";
const heroQuote = services.find((t) => t.id === (industry?.heroQuoteId ?? shefflerQuoteId));
const heroQuoteExcerpt = industry
  ? industry.heroQuoteExcerpt
  : "When my team finds something that needs to change, Mark fixes it fast, often the same day. At this point he knows how our business runs as well as anyone in the building.";
// The stat strip is Sheffler's numbers, so it would mislead under anyone else's quote.
const showShefflerStats = heroQuote?.id === shefflerQuoteId;
const midQuote = industry?.midQuoteId
  ? services.find((t) => t.id === industry.midQuoteId)
  : services.find((t) => t.customer_name?.includes("Kyle Simmons"));
const midQuoteExcerpt = industry?.midQuoteId
  ? industry.midQuoteExcerpt
  : "I came to Mark thinking I needed a new website. That's what I asked for. What I ended up getting was somebody who actually took the time to learn my business and came back with ideas I hadn't thought of.";
const excerpt = <T extends { text: string }>(t: T, text?: string) => (text ? { ...t, text } : t);

// markszymanski.co orders the rest newest first; this site's case studies carry a curated `order`
// instead, which also keeps a one-day startup consult from reading as the headline proof.
const leadStories = industry?.storyOrder ?? ["sheffler-and-company"];
const recentWork = [
  ...leadStories.map((id) => cases.find((c) => c.id === id)).filter((c) => c !== undefined),
  ...cases.filter((c) => !leadStories.includes(c.id)),
].slice(0, 4);

const p = pricing.fractional;

const takeover = [
  { name: "Your website", text: "Built for what you actually sell, hosted, kept current, and changed when you ask, with forms that send every lead to the right person." },
  { name: "Winning work", text: "Lead tracking that replaces the spreadsheet, follow-up that doesn't depend on someone remembering, and a pipeline you can see at a glance." },
  { name: "Quotes and proposals", text: "Proposals that draft themselves from your own past work, in your format, with the exhibits and fee rules built in." },
  { name: "Research before you quote", text: "The digging someone does on every job, like property records, zoning, or a client's background, done in one report with every source cited." },
  { name: "Booking and scheduling", text: "Booking pages that check your real calendar, take payment when it's needed, and send the reminders for you." },
  { name: "Running the work", text: "Job and project tracking, schedules and materials lists that turn into a clean PDF, and lookups your crew uses in the field." },
  { name: "Hiring", text: "A pipeline that finds candidates, sorts them, and keeps track of where each one is." },
  { name: "Money and reporting", text: "Bookkeeping that categorizes itself, a weekly scorecard, and one dashboard that shows where the business stands without asking anyone." },
  { name: "Your team and AI", text: "AI set up around your business, your team trained on it, and an assistant they can message that already knows how you work." },
  { name: "What the business knows", text: "How you price, how you do the work, and who your clients are, written down once where your people and your AI can both use it." },
  { name: "Staying in front of clients", text: "Newsletters drafted for you, testimonials collected and kept in one place, and personal video pages for the prospects that matter." },
  { name: "Keeping it safe", text: "Nightly backups, domains watched so nothing lapses, and every system documented so it never depends on one person." },
];

const yearly = (monthly: string) => (Number(monthly.replace(/,/g, "")) * 12).toLocaleString("en-US");

// Verified on bls.gov October 27, 2026: OEWS May 2025 medians (web developers $99,520, software
// developers $135,980); ECEC June 2026, benefits = 30% of private-industry compensation, so benefits
// = salary x 30/70. Recruiter 15-30% of first-year salary is a vendor-reported range, not BLS.
// Re-check when BLS publishes May 2026 wages (spring 2027), here and on markszymanski.co.
const hires = [
  {
    name: "An in-house web developer",
    total: "$157,000+",
    lines: ["$99,520 salary (the national median)", "+ $42,650 benefits and payroll taxes", "+ $15,000 to $30,000 to a recruiter"],
    note: "Builds websites. Your systems, your AI, and deciding what's worth building still need someone else.",
  },
  {
    name: "An in-house software developer",
    total: "$215,000+",
    lines: ["$135,980 salary (the national median)", "+ $58,300 benefits and payroll taxes", "+ $20,000 to $40,000 to a recruiter"],
    note: "Can build the systems. A senior one costs more, and still needs you to tell them what moves the business.",
  },
];

const hidden = [
  "One to three months to find them, then more months while they learn your business.",
  "Bring on someone junior to save money and you pay them to learn on your dime, and you're the one teaching.",
  "Bring on someone senior and you pay for it, then you manage them, review their work, and keep them busy.",
  "When they leave, what they built and how it works can walk out with them. Everything I build is documented.",
  "An employee does tasks. This ships systems that keep working after they're built.",
];

// Our own silent 12-second clip on top (no Bunny chrome before the click), Bunny's iframe primed
// underneath, handed over through Player.js on click. Why each piece is the way it is:
// AIOS pipelines/web-build/video-on-a-page.md. Same video and files as markszymanski.co/work-with-me.
const videoBase = "https://iframe.mediadelivery.net/embed/572643/6c6ea7ee-887c-4a68-98f3-f3336250a73c";
const videoBaseParams = "preload=true&responsive=true&rememberPosition=false&showSpeed=true";
const videoPreviewSrc = `${videoBase}?autoplay=true&muted=true&loop=false&${videoBaseParams}`;
const videoPlaySrc = `${videoBase}?autoplay=true&muted=false&loop=false&${videoBaseParams}`;
const videoLoop = "https://cdn.markszymanski.co/work-with-me/wwm-intro-loop-v2.mp4";
const videoPoster = "https://cdn.markszymanski.co/work-with-me/wwm-intro-poster-v2.jpg";
const videoDuration = "2:01";
const inWords = (n: number) => ["zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten"][n] ?? String(n);

// The left column can be specific because it is one person's actual words. The right column stays
// industry-neutral: naming a trade there reads as "he only works with surveying firms."
const sentences = [
  ["\"I know what to charge. I just can't be the one writing forty proposals a month.\"", "Pulled the pricing logic and the scope language out of a decade of past proposals. The first draft writes itself now, and the people who actually price the work still make that call."],
  ["\"Before we can quote a job I have to check the flood maps, the wetlands, the soils, the mining and the slope. Every single time.\"", "One lookup instead of ten, and the report comes back with its sources cited so nothing has to be taken on trust. Half a day became a few seconds."],
  ["\"Somebody has to open every one of these emails, read it, and type the important parts into a spreadsheet.\"", "The documents get read, named properly and filed to the right place on their own. No AI guessing involved, so it is either exactly right or it stops and asks."],
  ["\"People fill out the form on our site and I don't find out for a day. Sometimes two.\"", "Rewired the intake so a lead reaches a human immediately and gets recorded, instead of sitting in a mailbox nobody watches."],
  ["\"Our site looks like it was built in 2015, and every small change means emailing somebody and waiting a week.\"", "Rebuilt it static and fast, archived the old one, redirected every old URL, and got it off the ageing server. Then I keep it running."],
  ["\"I tried ChatGPT but it doesn't know anything about my business, so I gave up.\"", "The most common one, and the tool was never the problem. It had no context to work from. Giving it that context is most of what I actually do."],
];

const tracks = [
  {
    name: "Bringing in more revenue",
    body: industry?.leadsBody ?? "I look at how your business brings in revenue: how many of the right people find you, how many reach out, how many sign, and how much more your current customers buy or send your way. Then I fix the step that's leaking the most.",
    measures: industry?.leadsMeasures ?? ["New inquiries/month", "Signed jobs/month", "Repeat and referral work"],
  },
  {
    name: "Taking work off your team's plate",
    body: industry?.organizedBody ?? "Less of your team's week spent on work software should be doing. Quotes, proposals, intake, scheduling, reporting. Custom tools your team uses every day, built around how you already work.",
    measures: industry?.organizedMeasures ?? ["Hours your team spends on it each week", "How long a quote or proposal takes", "Work handled without adding staff"],
  },
];

const steps = [
  {
    title: "A 20-minute intro call",
    body: "Tell me what's going on and I'll tell you straight whether I can move it. If not, I'll say so.",
  },
  {
    title: "Kickoff",
    body: "Time with you first, then short conversations with the people who actually do the work, over video or in person if you're local: how work comes in, who does what, and where it gets stuck. You're too deep in your business to see all of it, which is normal, and it's why you bring in someone from outside. Then I tell you what I'd fix first and why, pick the number that proves it, measure where it is today, and write the plan for your first three months. No paid audit, no report that sits on a shelf.",
  },
  {
    title: "The first three months",
    body: "I work the plan. One thing at a time, shipped, working, and actually used by your team, then the next. The first one is in your team's hands within 30 days, or your second month is free. If something better shows up along the way, we swap it in.",
  },
  {
    title: "After that",
    body: `Keep going month to month and I bring you the next number to go after. Or step down to Care, $${pricing.website.care}/month to keep your website online, and call me when you need the next project.`,
  },
];

const included = [
  "A strategy call and a one-page report: your number first, then what shipped.",
  "My read on any tech or AI decision before you spend money on it.",
  "Everything I build, kept running, and fixed within one business day if it breaks.",
  "Your team trained on everything I build, and I check that it's actually getting used.",
  "Your website, rebuilt on my stack if I didn't build it, then hosted and kept running. I only run what I build.",
];

const excluded = [
  "Ad spend. If we run ads, the budget is yours.",
  "Usage costs: AI credits, paid software, and anything billed by usage. You pay the provider directly.",
  "General IT: email accounts, laptops, printers, other vendors' software.",
  "Nights and weekends, unless something I built is down.",
  "Big builds, like a client portal. Quoted separately, or covered by extending your minimum.",
];

const faqs = [
  {
    q: "How many hours do I get?",
    a: "I don't track hours, and you don't buy them. You're paying for your number to move. I use AI and modern tooling, so a lot of what used to take weeks takes days, and that speed goes to you as more shipped work, not a smaller bill.",
  },
  {
    q: "How much of my time does this take?",
    a: "Less than a project would, but not zero, and you wouldn't want zero. I need you for what only you know: how the business really runs, and whether what I built works before your team gets it. While something's being built, that's a short check-in each week, and I'll come to you or whoever knows the work when I have a question. I also train your team and show you every month who's using what I built. The one thing only you can do is tell them it's how the work gets done now.",
  },
  {
    q: "How long until I see results?",
    a: "The first thing usually ships in the first few weeks. The number takes longer to move, which is why there's a three-month minimum: that's enough time to show it.",
  },
  {
    q: "What if nothing happens?",
    a: "Then you don't pay for it. If nothing I've built is in your team's hands within 30 days of kickoff, your second month is free. The only condition is that you give me the access and the time with your team that we agree on at kickoff.",
  },
  {
    q: "Will you talk about our work publicly?",
    a: "Yes, the parts that aren't confidential. Telling the story of what we built is how I get new work, and it puts your business in front of my audience too. Your clients, your data, and anything proprietary never go in it. If you need the whole engagement kept private, that's available, and the price doubles.",
  },
  {
    q: "We tried AI tools before and nothing stuck. Why is this different?",
    a: "Because a tool on its own doesn't know your business and nobody owns getting your team to use it. I set it up around how you actually work, train your people on it, and stay to keep it working.",
  },
  {
    q: "Will this replace people on my team?",
    a: "That's not the goal. The goal is your people spending their time on the work only they can do, instead of copying, pasting, and chasing things a system can handle.",
  },
  industry?.industryFaq ?? {
    q: "Have you worked in my industry?",
    a: "Maybe not, and it matters less than you'd think. I've done this for an engineering firm, a law firm, an insurance agency, a landscaper, a roofer, and a nonprofit, and the problems repeat: leads slip through, quotes take too long, and how things get done lives in one person's head. I learn how your business works fast, and kickoff exists for exactly that. If yours is outside what I can help with, I'll tell you on the intro call.",
  },
  {
    q: "I'm already a client. What happens to what I pay now?",
    a: "It rolls in. While I'm your fractional lead, your website care and anything else I run for you is covered by the one fee. If you ever stop, we just go back to billing those pieces separately, like before.",
  },
  {
    q: "Do I tell you what to build?",
    a: "No. You tell me about your business: how work comes in, where it gets stuck, and what you've already tried. Deciding what to build is my job, and it's what you're paying for. If you have an idea, I'll tell you straight whether it moves your number.",
  },
  {
    q: "What if I need both?",
    a: "Most businesses do. I start with whichever one is costing you more right now, and switch when it's handled.",
  },
  {
    q: "Can I get it cheaper?",
    a: "No. The price is the price, and it's on this page so you never have to find out on a call. Custom pricing exists for when you've outgrown the plan (a bigger team, a bigger build), not for making it smaller.",
  },
  {
    q: "What if I need something bigger, like a client portal?",
    a: "Bigger builds are quoted on their own. Or, instead of paying for the build up front, you can extend your minimum to cover it.",
  },
  {
    q: "Do I need to be technical?",
    a: "No. That's the point. You run your business, I build and run the systems. Everything gets documented, so your team can see how it works.",
  },
  {
    q: "What happens after three months?",
    a: `You keep going month to month and I bring you the next number to go after, or you step down to Care at $${pricing.website.care}/month, which keeps your website online, and call me when you need the next project.`,
  },
  {
    q: "What if we want to run it ourselves someday?",
    a: "Tell me on the first call, and I'll plan for it from day one. Everything I build is yours, and all of it is documented. The three-month minimum is how long it takes to learn your business and move your number, not a lock-in. After that, stay as long as it's worth it, or I'll train your team to run it while I'm still on and then step back. I'd much rather know up front than find out later.",
  },
];

const path = industry ? `/fractional/${industry.slug}` : "/fractional";
const schema = [
  breadcrumb([
    { name: "Home", url: site.url },
    { name: "Fractional AI and Systems Lead", url: `${site.url}/fractional` },
    ...(industry ? [{ name: industry.eyebrow, url: `${site.url}${path}` }] : []),
  ]),
  { "@type": "FAQPage", mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
];
---

<BaseLayout
  title={industry?.metaTitle ?? "Fractional AI and Systems Lead | Motive11"}
  description={industry?.metaDescription ?? "The AI and systems person your business is missing, without the full-time hire. I run your website and systems, and every month I work on more revenue or less busywork for your team."}
  schema={schema}
>
  <section class="hero">
    <div class="wrap">
      <div class="col">
        <span class="label">{industry?.eyebrow ?? "Fractional AI and Systems Lead"}</span>
        <!-- The emphasis is a weight step plus the orange underline, not a color: dimming the setup
             failed contrast in light mode on markszymanski.co. -->
        <h1>{industry?.h1Setup ?? "The AI and systems person your business is missing,"} <span class="payoff">without the full-time hire.</span></h1>
        <p class="lead">
          {industry?.intro ?? "I figure out what's holding your business back, then build the custom software and AI systems that fix it, keep them running, and improve them every month: more revenue, or less busywork for your team."}
        </p>

        <figure class="stage" data-stage data-play-src={videoPlaySrc}>
          <iframe
            src={videoPreviewSrc}
            title="Fractional AI and Systems Lead"
            loading="eager"
            allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
            allowfullscreen
            class="frame is-hidden"
            data-frame
            tabindex="-1"
            aria-hidden="true"></iframe>
          <video class="loop" src={videoLoop} poster={videoPoster} autoplay muted loop playsinline preload="auto" aria-hidden="true" data-loop></video>
          <button type="button" class="play" data-play data-overlap-ok aria-label="Play the video with sound">
            <span class="play-row">
              <span class="play-dot">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" /></svg>
              </span>
              <span class="play-label">Play with sound &middot; {videoDuration}</span>
            </span>
          </button>
        </figure>

        <p class="body-lg">
          {industry?.audience ?? "This is for established businesses that need someone to own their website, their systems, and their AI, and don't want to hire for it. One person, one monthly fee, working on whatever moves your business most."}
        </p>
        <p class="body-lg">
          I find what's costing you the most, measure where it is today, fix it one thing at a time, and show you the number every month.
        </p>
        {p.earlySpotsLeft > 0 && (
          <div class="spots">
            <span class="pulse" aria-hidden="true"><i></i><i></i></span>
            <span>
              <b>{p.earlySpotsLeft} {p.earlySpotsLeft === 1 ? "spot" : "spots"} left at ${p.earlyMonthly}/month.</b>
              <span class="dim"> Then it goes to ${p.monthly}/month, and anyone in at ${p.earlyMonthly} keeps it for their first 12 months.</span>
            </span>
          </div>
        )}
        <div class="actions">
          <a class="btn" href="#start" data-scroll-to="start" data-cta="top">Book an intro call <svg class="arrow"><use href="#arrow" /></svg></a>
          <a class="btn ghost" href="#details" data-scroll-to="details">See the details</a>
        </div>
        <p class="note">
          Doing under $3M a year? <a class="inline" href="/ai-onboarding-day" data-track="Fractional onboarding day clicked (top)">Start with the AI Onboarding Day</a>.
        </p>
        {p.earlySpotsLeft === 0 && (
          <p class="note">${p.monthly}/month. I work with {inWords(p.totalSpots)} businesses at a time.</p>
        )}
      </div>
    </div>
  </section>

  <div class="wrap logos">
    <ClientLogos caption="Businesses I've worked with" />
    <p class="logos-line">Engineering, law, insurance, landscaping, roofing, nonprofits, sports, and software. The industries change. The problems mostly don't.</p>
  </div>

  {heroQuote && (
    <section class="quote-sec">
      <div class="wrap">
        <div class="reveal">
          <Testimonial q={excerpt(heroQuote, heroQuoteExcerpt)} variant="feature" />
          {!showShefflerStats && storyFor.get(heroQuote.id) && (
            <p class="quote-link"><a class="text-link" href={storyFor.get(heroQuote.id)}>Read the case study <svg class="arrow"><use href="#arrow" /></svg></a></p>
          )}
        </div>
        {showShefflerStats && (
          <div class="stats reveal">
            <!-- Lower bounds on purpose (portal figures as of October 23, 2026: 106 proposals, 27 web
                 leads), so the line stays true as the counts keep climbing. Re-check before raising. -->
            <div class="stat-grid">
              {[
                ["100+", "proposals written in their own software"],
                ["25+", "website leads straight into their pipeline, none retyped"],
                ["44", "days from yes to their system going live"],
              ].map(([n, label]) => (
                <div>
                  <p class="stat-n">{n}</p>
                  <p class="stat-l">{label}</p>
                </div>
              ))}
            </div>
            <p class="stat-src">
              Sheffler &amp; Company, since July 2026. <a class="inline" href="/case-studies/sheffler-and-company">Read the case study</a>
            </p>
          </div>
        )}
      </div>
    </section>
  )}

  <section id="details" class="block band anchor">
    <div class="wrap">
      <div class="col reveal">
        <span class="label">What I solve for you</span>
        <h2>It's almost always one of two problems. Kickoff tells me which one to fix first.</h2>
        <div class="tracks">
          {tracks.map((t) => (
            <div class="card">
              <h3>{t.name}</h3>
              <p class="muted">{t.body}</p>
              <p class="mini">What we'd measure, for example</p>
              <ul class="plus">
                {t.measures.map((m) => <li>{m}</li>)}
              </ul>
            </div>
          ))}
        </div>
        <ol class="loop-steps">
          {["Find the problem", "Measure where it is today", "Fix it", "Measure again, then repeat"].map((step, i) => (
            <li class="card">
              <span class="n">0{i + 1}</span>
              <span>{step}</span>
            </li>
          ))}
        </ol>
        <p class="muted after">Every month you see the number next to where it started, so you always know what you're paying for.</p>
        <div class="cta"><a class="btn" href="#start" data-scroll-to="start" data-cta="tracks">Book an intro call <svg class="arrow"><use href="#arrow" /></svg></a></div>
      </div>
    </div>
  </section>

  <section id="familiar" class="block anchor">
    <div class="wrap">
      <div class="col reveal">
        <span class="label">Sound familiar?</span>
        <h2>Real sentences, said to me by real business owners. And what I did about each one.</h2>
        <p class="lead">Not one of them called it a technology problem. They described something that hurts. If any of these is close to something you'd say out loud, we should talk.</p>
        <div class="said">
          <div class="said-head">
            <span>What they said</span>
            <span>How I solved it</span>
          </div>
          {sentences.map(([said, solved]) => (
            <div class="said-row">
              <p class="said-q">{said}</p>
              <p class="said-a">{solved}</p>
            </div>
          ))}
        </div>
        <div class="cta"><a class="btn" href="#start" data-scroll-to="start" data-cta="familiar">Book an intro call <svg class="arrow"><use href="#arrow" /></svg></a></div>
      </div>
    </div>
  </section>

  <section class="block band">
    <div class="wrap">
      <div class="col reveal">
        <span class="label">How it works</span>
        <h2>Here's exactly what happens.</h2>
        <div class="steps">
          {steps.map((s, i) => (
            <div class="step">
              <span class="n">0{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
          ))}
        </div>
        <div class="cta"><a class="btn" href="#start" data-scroll-to="start" data-cta="how">Book an intro call <svg class="arrow"><use href="#arrow" /></svg></a></div>
      </div>
    </div>
  </section>

  {midQuote && (
    <section class="quote-sec mid">
      <div class="wrap reveal">
        <Testimonial q={excerpt(midQuote, midQuoteExcerpt)} variant="feature" />
        {storyFor.get(midQuote.id) && (
          <p class="quote-link"><a class="text-link" href={storyFor.get(midQuote.id)}>Read the case study <svg class="arrow"><use href="#arrow" /></svg></a></p>
        )}
      </div>
    </section>
  )}

  <section class="block band">
    <div class="wrap">
      <div class="who reveal">
        <figure class="portrait">
          <Image src={portrait} alt="Mark Szymanski" widths={[400, 640]} sizes="(min-width: 768px) 280px, 240px" loading="lazy" />
        </figure>
        <div>
          <span class="label">Who you'd be working with</span>
          <h2>Me. Not a team you'll never meet.</h2>
          <p class="who-lead">I'm Mark. I run my own business on the same kind of AI setup I'd build for yours.</p>
          <p class="muted">You work with me directly, from the first call on, and I'm the one who answers when something needs to change. Before we talk, read how I work. If it sounds right to you, we'll get along.</p>
