  <script is:inline src="https://book.motive11.com/widget.js" defer></script>
  <script is:inline src="https://assets.mediadelivery.net/playerjs/playerjs-latest.min.js"></script>
  <script is:inline>
    (function () {
      var track = function (name) {
        try { if (window.fathom) window.fathom.trackEvent(name); } catch (e) {}
      };

      // Delegated so CTAs that come after this script in the DOM still scroll instead of snapping.
      document.addEventListener("click", function (e) {
        var tracked = e.target.closest("[data-track]");
        if (tracked && !tracked.hasAttribute("data-booking")) track(tracked.dataset.track);
        var el = e.target.closest("[data-scroll-to]");
        if (!el) return;
        if (el.dataset.cta) {
          track("Fractional call clicked");
          track("Fractional call clicked (" + el.dataset.cta + ")");
        }
        var target = document.getElementById(el.dataset.scrollTo);
        if (!target) return;
        e.preventDefault();
        target.scrollIntoView({ behavior: "smooth", block: "start" });
      });

      // How far down people read: each fires once per visit, so Fathom's counts are visitors.
      if ("IntersectionObserver" in window) {
        [["price", "Fractional saw price"], ["start", "Fractional saw form"]].forEach(function (pair) {
          var el = document.getElementById(pair[0]);
          if (!el) return;
          var io = new IntersectionObserver(function (entries) {
            if (!entries.some(function (en) { return en.isIntersecting; })) return;
            track(pair[1]);
            io.disconnect();
          }, { threshold: 0.4 });
          io.observe(el);
        });
      }

      var stage = document.querySelector("[data-stage]");
      if (!stage) return;
      var btn = stage.querySelector("[data-play]");
      var frame = stage.querySelector("[data-frame]");
      if (!btn || !frame) return;
      var loop = stage.querySelector("[data-loop]");
      var player = window.playerjs ? new window.playerjs.Player(frame) : null;
      var started = false;

      // A click can land before the priming timer fires; without the started guard the timer
      // would pause the video the viewer just started.
      if (player) {
        player.on("ready", function () {
          player.mute();
          player.play();
          setTimeout(function () {
            if (started) return;
            player.pause();
            player.setCurrentTime(0);
          }, 2500);
        });
      }

      btn.addEventListener("click", function () {
        started = true;
        btn.remove();
        if (loop) loop.remove();
        frame.classList.remove("is-hidden");
        frame.removeAttribute("tabindex");
        frame.removeAttribute("aria-hidden");
        track("Fractional video played");
        if (!player) {
          frame.src = stage.dataset.playSrc;
          return;
        }
        player.setCurrentTime(0);
        player.unmute();
        player.setVolume(100);
        player.play();
        // If the browser refused the programmatic unmute, reload into the unmuted URL.
        setTimeout(function () {
          player.getMuted(function (muted) {
            if (muted) frame.src = stage.dataset.playSrc;
          });
        }, 900);
      }, { once: true });
    })();
  </script>
</BaseLayout>

