---
import { site } from "../lib/site";

interface Props {
  heading?: string;
  body?: string;
}

const {
  heading = "Bring me the job that eats your team's week.",
  body = "The first call is 20 minutes. If I can help, I'll tell you how. If I can't, I'll tell you that too.",
} = Astro.props;
---

<section class="close">
  <div class="wrap inner">
    <span class="label">Start here</span>
    <h2>{heading}</h2>
    <p>{body}</p>
    <a class="btn" href={site.introCall}>Book a 20-minute intro call <svg class="arrow"><use href="#arrow" /></svg></a>
  </div>
</section>

<style>
  .close { position: relative; overflow: hidden; text-align: center; padding-block: clamp(90px, 11vw, 140px) clamp(100px, 12vw, 150px); }
  .close::before {
    content: ""; position: absolute; left: 50%; bottom: -40%; width: 1100px; max-width: 160%; height: 90%; transform: translateX(-50%);
    background: radial-gradient(ellipse 50% 50% at 50% 100%, var(--glow), transparent 70%);
    opacity: 0.55; filter: blur(10px); pointer-events: none;
  }
  .inner { position: relative; }
  h2 { font-size: clamp(36px, 4.6vw, 60px); max-width: 15em; margin: 0 auto; }
  p { color: var(--muted); font-size: 19px; margin: 22px auto 0; max-width: 28em; text-wrap: pretty; }
  .btn { margin-top: 36px; }
  @media (max-width: 560px) { p { font-size: 17px; } }
</style>
