---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<!-- Mark opens this once in each of his browsers as /me/?k=<his visitor_keys code> (AIOS
     state/VISITORS.md): Head.astro sends the ?k=, which ties the browser to him in the visitor ledger
     and so hides it on Mission Control's Visitors tab. The button carries that same ID to
     markszymanski.co with the cross-site handoff. Fathom's own skip runs too, only while Fathom is
     still on the site. -->
<BaseLayout title="This Browser - Motive11" description="This browser is marked as Mark's own." noindex>
  <section class="me">
    <div class="wrap">
      <h1>This browser is you now.</h1>
      <p class="lead">Your visits from this browser won't show on the Visitors tab. One more tap does the same on markszymanski.co.</p>
      <p class="next"><a class="btn" href="https://markszymanski.co/me/">Now markszymanski.co</a></p>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    // Fathom is on its way out (AIOS state/VISITORS.md); while it still runs here, skip Mark too.
    var tries = 0;
    (function block() {
      if (window.fathom && typeof window.fathom.blockTrackingForMe === "function") window.fathom.blockTrackingForMe();
      else if (tries++ < 40) setTimeout(block, 250);
    })();
  })();
</script>

<style>
  .me { padding-block: clamp(96px, 12vw, 160px); }
  .lead { margin-top: 20px; max-width: 32em; }
  .next { margin-top: 32px; }
</style>
