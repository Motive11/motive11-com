---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CaseRow from "../components/CaseRow.astro";
import ClientLogos from "../components/ClientLogos.astro";
import ClosingCta from "../components/ClosingCta.astro";
import { site } from "../lib/site";
import { offers } from "../lib/offers";
import Testimonial from "../components/Testimonial.astro";
import { fetchTestimonial } from "../lib/testimonials";
import portrait from "../assets/mark/portrait.webp";
import shefflerPortal from "../assets/case-studies/sheffler-and-company/portal-leads-queue.webp";
import shefflerSite from "../assets/case-studies/sheffler-and-company/new-home-desktop.webp";
import pwSite from "../assets/case-studies/polverini-and-wiater/new-home-desktop.webp";
import valorSite from "../assets/case-studies/valor-pgh/new-home-desktop.webp";
import v3Site from "../assets/case-studies/valiant-3-communications/new-home-desktop.webp";
import qclSite from "../assets/case-studies/quality-choice-landscaping/new-home-desktop.webp";
import bshfSite from "../assets/case-studies/bus-stops-here-foundation/new-home-desktop.webp";

const cases = (await getCollection("case-studies")).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
// Bud Sheffler's, because it has his photo. The excerpt is his own words, the same lines the Fractional page uses.
const bud = await fetchTestimonial("8b67a481-a547-4d8f-a6e1-c4554bb6f0fe");
const quote = bud && { ...bud, text: "When my team finds something that needs to change, Mark fixes it fast, often the same day. At this point he knows how our business runs as well as anyone in the building." };

const showcase = [
  { img: shefflerPortal, addr: "Sheffler & Company portal", alt: "The lead queue in the portal I built for Sheffler & Company, shown with demo data", caption: "A proposal portal for Sheffler & Company, an engineering and surveying firm", href: "/case-studies/sheffler-and-company" },
  { img: shefflerSite, addr: "shefflerco.com", alt: "The Sheffler & Company website", caption: "The Sheffler & Company website, rebuilt before the portal", href: "/case-studies/sheffler-and-company" },
  { img: pwSite, addr: "pw-legal.com", alt: "The Polverini & Wiater website", caption: "A new website for Polverini & Wiater, a law firm in the middle of a rebrand", href: "/case-studies/polverini-and-wiater" },
  { img: valorSite, addr: "valorpgh.com", alt: "The Valor PGH website", caption: "A website and lead system for Valor PGH, an insurance and real estate agency", href: "/case-studies/valor-pgh" },
  { img: v3Site, addr: "valiant3communications.com", alt: "The Valiant 3 website", caption: "A rebuilt website for Valiant 3, a sports agency", href: "/case-studies/valiant-3-communications" },
  { img: qclSite, addr: "qualitychoicelandscaping.com", alt: "The Quality Choice Landscaping website", caption: "A website and back office for Quality Choice Landscaping", href: "/case-studies/quality-choice-landscaping" },
  { img: bshfSite, addr: "thebusstopsherefoundation.org", alt: "The Bus Stops Here Foundation website", caption: "One website for The Jerome Bettis Bus Stops Here Foundation", href: "/case-studies/bus-stops-here-foundation" },
];
---

<BaseLayout
  title="Motive11 | AI and systems for established businesses, by Mark Szymanski"
  description={site.description}
>
  <div class="hero">
    <div class="wrap">
      <a class="pill" href="/case-studies/sheffler-and-company"><span class="dot"></span>How I built an engineering firm's proposal portal in 44 days<svg class="arrow"><use href="#arrow" /></svg></a>
      <h1>I build the systems your business runs on.</h1>
      <p class="sub">I'm <span class="name">Mark Szymanski</span>. I find the expensive, repetitive work inside a business and build the system that does it instead, then I stay on to keep it running. Motive11 is my company, and <b>it's just me, plus AI doing the work a team used to.</b></p>
      <div class="actions">
        <a class="btn" href="/fractional">Work With Me <svg class="arrow"><use href="#arrow" /></svg></a>
        <a class="text-link" href="/case-studies">See the Work <svg class="arrow"><use href="#arrow" /></svg></a>
      </div>

      <div class="stage" data-showcase>
        <div class="browser">
          <div class="bar">
            <div class="lights"><i></i><i></i><i></i></div>
            <div class="addr" data-addr>{showcase[0].addr}</div>
            <div class="spacer"></div>
          </div>
          <div class="screens">
            {showcase.map((s, i) => (
              <Image class:list={["screen", { "is-on": i === 0 }]} src={s.img} alt={s.alt} widths={[800, 1400, 2200]} sizes="(min-width: 1140px) 1100px, 100vw" loading={i === 0 ? "eager" : "lazy"} data-screen data-addr-text={s.addr} data-caption={s.caption} data-href={s.href} />
            ))}
          </div>
        </div>
        <div class="showcase-foot">
          <p class="caption"><span data-cap>{showcase[0].caption}</span>. <a href={showcase[0].href} data-caption-link>Read the Case Study</a></p>
          <div class="dots" role="tablist" aria-label="Projects">
            {showcase.map((s, i) => (
              <button type="button" class:list={["dot", { "is-on": i === 0 }]} aria-label={s.addr} aria-selected={i === 0 ? "true" : "false"} data-dot={i}></button>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="wrap logos-wrap"><ClientLogos /></div>

  <section class="block">
    <div class="wrap how">
      <figure class="portrait reveal">
        <Image src={portrait} alt="Mark Szymanski" widths={[480, 800, 1100]} sizes="(min-width: 1024px) 460px, 90vw" />
        <figcaption><b>Mark Szymanski</b><span>Founder, Motive11</span></figcaption>
      </figure>
      <div>
        <span class="label">How it works</span>
        <h2>One person and a lot of AI, instead of an agency and a lot of meetings.</h2>
        <div class="steps">
          <div class="step">
            <span class="n">1</span>
            <h3>I find where the week goes</h3>
            <p>I learn what your team does all day and find the one job that costs the most time.</p>
          </div>
          <div class="step">
            <span class="n">2</span>
            <h3>I build it around how you work</h3>
            <p>The system fits the way your people already do the job, so nobody has to learn a new way of working.</p>
          </div>
          <div class="step">
            <span class="n">3</span>
            <h3>I stay on</h3>
            <p>When something needs to change, you tell me and it gets done. You never get handed off to someone else.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="block offers-sec">
    <div class="wrap">
      <div class="head">
        <div>
          <span class="label">What I do</span>
          <h2>Two ways to work with me.</h2>
        </div>
        <a class="text-link" href="/services">All the details <svg class="arrow"><use href="#arrow" /></svg></a>
      </div>
      <div class="offer-grid">
        {offers.map((o) => (
          <a class:list={["offer reveal", { featured: o.featured }]} href={o.page}>
            <h3>{o.name}</h3>
            <span class="price">{o.price}</span>
            <p>{o.short}</p>
            <span class="more">Learn more <svg class="arrow"><use href="#arrow" /></svg></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="block" id="work">
    <div class="wrap">
      <div class="head">
        <div>
          <span class="label">Recent work</span>
          <h2>Three firms, three different problems.</h2>
        </div>
        <a class="text-link" href="/case-studies">Every case study <svg class="arrow"><use href="#arrow" /></svg></a>
      </div>
      {cases.map((entry, i) => <CaseRow entry={entry} flip={i % 2 === 1} />)}
    </div>
  </section>

  {quote && (
    <section class="quote">
      <div class="wrap">
        <Testimonial q={quote} variant="feature" link="/case-studies/sheffler-and-company" />
      </div>
    </section>
  )}

  <section class="block">
    <div class="wrap">
      <span class="label">Who I build for</span>
      <h2>Established businesses doing $3 million or more a year.</h2>
      <div class="fit">
        <div><span class="label">The business</span><p>Ten or more people on payroll, with an office that keeps the work moving.</p></div>
        <div><span class="label">The problem</span><p>A specific person losing real hours every week to proposals, research, intake, scheduling, or data entry.</p></div>
        <div><span class="label">The owner</span><p>Knows the numbers, like how many leads come in and how many close, and wants the problem fixed for good.</p></div>
      </div>
      <p class="smaller">Under $3 million a year and already using AI? <a class="text-link" href="/ai-onboarding-day">Start with the AI Onboarding Day <svg class="arrow"><use href="#arrow" /></svg></a></p>
    </div>
  </section>

  <ClosingCta />
</BaseLayout>

<script is:inline>
  (function () {
    var root = document.querySelector("[data-showcase]");
    if (!root) return;
    var screens = root.querySelectorAll("[data-screen]");
    var dots = root.querySelectorAll("[data-dot]");
    var addr = root.querySelector("[data-addr]");
    var cap = root.querySelector("[data-cap]");
    var link = root.querySelector("[data-caption-link]");
    var i = 0, timer = null;
    function show(n) {
      screens[i].classList.remove("is-on"); dots[i].classList.remove("is-on"); dots[i].setAttribute("aria-selected", "false");
      i = (n + screens.length) % screens.length;
      screens[i].classList.add("is-on"); dots[i].classList.add("is-on"); dots[i].setAttribute("aria-selected", "true");
      addr.textContent = screens[i].dataset.addrText;
      cap.textContent = screens[i].dataset.caption;
      link.setAttribute("href", screens[i].dataset.href);
    }
    function start() { if (!timer) timer = setInterval(function () { show(i + 1); }, 4500); }
    function stop() { clearInterval(timer); timer = null; }
    dots.forEach(function (d) { d.addEventListener("click", function () { stop(); show(Number(d.dataset.dot)); start(); }); });
    root.addEventListener("mouseenter", stop);
    root.addEventListener("mouseleave", start);
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) start();
  })();
</script>

<style>
  .hero { text-align: center; padding-top: clamp(64px, 9vw, 120px); overflow-x: clip; }
  .pill { display: inline-flex; align-items: center; gap: 10px; padding: 7px 14px 7px 8px; border: 1px solid var(--line); background: var(--surface); border-radius: 999px; color: var(--muted); font-size: 14px; font-weight: 500; text-decoration: none; transition: border-color 0.15s ease, color 0.15s ease; }
  .pill:hover { color: var(--fg); border-color: rgba(255, 106, 26, 0.5); }
  .pill .dot { width: 22px; height: 22px; border-radius: 50%; background: rgba(255, 106, 26, 0.16); display: grid; place-items: center; flex: none; }
  .pill .dot::after { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--orange); }
  .pill .arrow { width: 14px; height: 14px; }
  h1 { max-width: 13.5em; margin: 30px auto 0; }
  .sub { margin: 26px auto 0; max-width: 35em; font-size: 20px; line-height: 1.55; color: var(--muted); letter-spacing: -0.01em; text-wrap: pretty; }
  .sub b { color: var(--fg); font-weight: 500; }
  .name { color: var(--fg); font-weight: 500; white-space: nowrap; }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 16px 30px; margin-top: 38px; }

  .stage { position: relative; margin-top: clamp(56px, 7vw, 88px); }
  .stage::before {
    content: ""; position: absolute; left: 50%; bottom: 40px; width: 120%; height: 95%; transform: translateX(-50%);
    background: radial-gradient(ellipse 52% 60% at 50% 100%, var(--glow), rgba(255, 106, 26, 0.18) 45%, transparent 74%);
    filter: blur(20px); pointer-events: none;
  }
  .browser { position: relative; max-width: 1100px; margin: 0 auto; border-radius: 14px; background: var(--surface); border: 1px solid var(--line); padding: 0 8px 8px; box-shadow: 0 40px 90px -30px var(--shadow); }
  .bar { display: flex; align-items: center; gap: 14px; height: 40px; padding-inline: 8px; }
  .lights { display: flex; gap: 7px; }
  .lights i { width: 11px; height: 11px; border-radius: 50%; background: var(--line); }
  .addr { flex: 1; max-width: 340px; margin: 0 auto; height: 24px; border-radius: 6px; background: var(--surface-2); color: var(--faint); font-size: 12px; display: flex; align-items: center; justify-content: center; white-space: nowrap; overflow: hidden; padding-inline: 10px; }
  .spacer { width: 47px; }
  .screens { position: relative; aspect-ratio: 16 / 10; border-radius: 7px; overflow: hidden; background: var(--surface-2); }
  .screens :global(.screen) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top; opacity: 0; transition: opacity 0.7s ease; }
  .screens :global(.screen.is-on) { opacity: 1; }
  .showcase-foot { position: relative; display: grid; justify-items: center; gap: 14px; margin-top: 22px; }
  .showcase-foot .caption { margin: 0; min-height: 3em; }
  .dots { display: flex; gap: 8px; }
  .dot { width: 8px; height: 8px; padding: 0; border-radius: 999px; border: 0; background: var(--faint); cursor: pointer; transition: width 0.3s ease, background 0.3s ease; }
  .dot.is-on { width: 24px; background: var(--orange); }
  .caption { position: relative; margin: 22px auto 0; max-width: 40em; color: var(--muted); font-size: 15px; }
  .caption a { color: var(--fg); text-decoration: none; font-weight: 500; border-bottom: 1px solid rgba(255, 106, 26, 0.6); }
  .caption a:hover { color: var(--accent-text); }

  .logos-wrap { padding-top: clamp(64px, 8vw, 96px); }

  .how { display: grid; gap: 48px; align-items: center; }
  .portrait { margin: 0; max-width: 460px; background: var(--surface); border: 1px solid var(--line); border-radius: 22px; padding: 14px 14px 18px; }
  .portrait :global(img) { width: 100%; height: auto; aspect-ratio: 1591 / 1989; object-fit: cover; border-radius: 12px; }
  .portrait figcaption { display: flex; justify-content: space-between; gap: 12px; margin-top: 14px; padding-inline: 4px; font-size: 15px; }
  .portrait figcaption b { font-weight: 500; }
  .portrait figcaption span { color: var(--faint); }
  .steps { margin-top: 44px; border-top: 1px solid var(--line); }
  .step { display: grid; grid-template-columns: 44px 1fr; gap: 6px 10px; padding-block: 26px; border-bottom: 1px solid var(--line); }
  .step .n { color: var(--accent-text); font-weight: 500; font-size: 20px; line-height: 1.3; }
  .step h3 { font-weight: 500; font-size: 22px; letter-spacing: -0.025em; line-height: 1.3; }
  .step p { grid-column: 2; color: var(--muted); }

  .offers-sec { padding-top: 0; }
  .head { display: flex; justify-content: space-between; align-items: end; gap: 24px 40px; flex-wrap: wrap; margin-bottom: clamp(44px, 6vw, 72px); }
  .offer-grid { display: grid; gap: 16px; }
  .offer { display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 28px 28px 26px; text-decoration: none; transition: border-color 0.15s ease, transform 0.15s ease; }
  .offer:hover { border-color: rgba(255, 106, 26, 0.55); transform: translateY(-2px); }
  .offer.featured { border-color: rgba(255, 106, 26, 0.45); background: linear-gradient(160deg, rgba(255, 106, 26, 0.12), var(--surface) 60%); }
  .offer h3 { font-weight: 500; font-size: 24px; letter-spacing: -0.025em; }
  .offer .price { color: var(--accent-text); font-weight: 500; margin-top: 4px; }
  .offer p { color: var(--muted); margin-top: 10px; flex: 1; }
  .offer .more { display: inline-flex; align-items: center; gap: 8px; margin-top: 22px; color: var(--accent-text); font-weight: 500; }

  #work { padding-top: 0; }

  .quote { background: var(--surface); border-block: 1px solid var(--line); text-align: center; padding-block: clamp(80px, 10vw, 120px); }

  .fit { display: grid; gap: 16px; margin-top: 48px; }
  .fit > div { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 28px 28px 32px; }
  .fit .label { font-size: 15px; margin-bottom: 12px; }
  .fit p { font-size: 19px; letter-spacing: -0.015em; line-height: 1.4; }
  .smaller { margin-top: 30px; color: var(--muted); display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: center; }

  @media (min-width: 1024px) {
    .how { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(48px, 6vw, 96px); }
    .offer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .fit { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .sub { font-size: 18px; }
    .pill { font-size: 13px; text-align: left; }
    .actions { flex-direction: column; gap: 22px; }
    .browser { padding: 0 5px 5px; border-radius: 10px; }
    .bar { height: 30px; gap: 8px; padding-inline: 5px; }
    .lights i { width: 8px; height: 8px; }
    .addr { height: 18px; font-size: 10px; }
    .spacer { width: 0; }
    .fit p { font-size: 18px; }
  }
</style>
