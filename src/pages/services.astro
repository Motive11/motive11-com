---
import BaseLayout from "../layouts/BaseLayout.astro";
import ClientLogos from "../components/ClientLogos.astro";
import ClosingCta from "../components/ClosingCta.astro";
import { offers } from "../lib/offers";
import { breadcrumb } from "../lib/schema";
import { site } from "../lib/site";

const title = "Services | Motive11";
const description = "Partnership, the AI Onboarding Day, websites, and custom software. What each one is, who it's for, and how it starts.";
const schema = [
  breadcrumb([{ name: "Home", url: site.url }, { name: "Services", url: `${site.url}/services` }]),
  ...offers.map((o) => ({ "@type": "Service", name: o.name, description: o.short, provider: { "@id": `${site.url}/#organization` } })),
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <section class="intro">
    <div class="wrap">
      <span class="label">Services</span>
      <h1>Four ways to work with me.</h1>
      <p class="lead">Every one of them is me doing the work, from the first call to the last change. Most firms start with a call, and I'll tell you which of these fits, or if none do.</p>
      <nav class="jump" aria-label="Services on this page">
        {offers.map((o) => <a href={`#${o.id}`}>{o.name}</a>)}
      </nav>
    </div>
  </section>

  <div class="wrap list">
    {offers.map((o) => (
      <article id={o.id} class:list={["offer reveal", { featured: o.featured }]}>
        <div class="main">
          {o.featured && <span class="tag">The main way I work</span>}
          <h2>{o.name}</h2>
          <p class="short">{o.short}</p>
          <p class="for"><b>Who it's for.</b> {o.forWho}</p>
          <p class="starts"><b>How it starts.</b> {o.starts}</p>
          <a class="btn" href={o.cta.href}>{o.cta.label} <svg class="arrow"><use href="#arrow" /></svg></a>
        </div>
        <div class="side">
          <span class="label">What you get</span>
          <ul>
            {o.includes.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </article>
    ))}
  </div>

  <div class="wrap proof"><ClientLogos caption="Some of the firms I've built for" /></div>

  <ClosingCta heading="Not sure which one fits?" body="That's what the first call is for. It's 20 minutes, and I'll tell you what I'd do, or that I'm not the right fit." />
</BaseLayout>

<style>
  .intro { padding-block: clamp(64px, 9vw, 112px) clamp(40px, 5vw, 64px); }
  .intro h1 { max-width: 12em; }
  .jump { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 34px; }
  .jump a { padding: 8px 16px; border: 1px solid var(--line); border-radius: 999px; color: var(--muted); text-decoration: none; font-size: 15px; font-weight: 500; }
  .jump a:hover { color: var(--fg); border-color: var(--orange); }
  .list { display: grid; gap: 20px; padding-bottom: clamp(80px, 10vw, 120px); }
  .offer { display: grid; gap: 32px; background: var(--surface); border: 1px solid var(--line); border-radius: 20px; padding: clamp(28px, 4vw, 48px); scroll-margin-top: 96px; }
  .offer.featured { border-color: rgba(255, 106, 26, 0.45); background: linear-gradient(160deg, rgba(255, 106, 26, 0.12), var(--surface) 55%); }
  .tag { display: inline-block; color: var(--accent-text); font-weight: 500; font-size: 15px; margin-bottom: 12px; }
  h2 { font-size: clamp(30px, 3.2vw, 42px); }
  .short { color: var(--fg); font-size: 20px; line-height: 1.45; letter-spacing: -0.015em; margin-top: 16px; max-width: 32em; }
  .for, .starts { color: var(--muted); margin-top: 16px; max-width: 34em; }
  .for b, .starts b { color: var(--fg); font-weight: 500; }
  .btn { margin-top: 28px; }
  .side .label { font-size: 15px; }
  ul { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  li { padding: 14px 0 14px 28px; border-bottom: 1px solid var(--line); position: relative; color: var(--fg); }
  li::before { content: ""; position: absolute; left: 2px; top: 22px; width: 12px; height: 7px; border-left: 2px solid var(--orange); border-bottom: 2px solid var(--orange); transform: rotate(-45deg); }
  .proof { padding-bottom: clamp(40px, 6vw, 72px); }
  @media (min-width: 1024px) {
    .offer { grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); gap: clamp(40px, 5vw, 72px); }
  }
  @media (max-width: 560px) {
    .short { font-size: 18px; }
  }
</style>
