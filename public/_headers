# Security headers. Standard: AIOS pipelines/web-build/security-headers.md.
# No includeSubDomains or preload on HSTS (see the standard for why).
# The CSP allowlist is every third party the site loads: Fathom, Cloudflare Web Analytics, and on
# /book the shared booking form from book.motive11.com, Cloudflare's bot check
# (challenges.cloudflare.com), and Stripe's card form (js.stripe.com, api.stripe.com,
# hooks.stripe.com, and payment for Apple Pay / Google Pay). Fonts are self-hosted, so no font host.
# Adding a new embed or script means adding its origin here in the same change, or it is silently
# blocked on the live site (astro dev ignores this file).
/*
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: SAMEORIGIN
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self "https://js.stripe.com" "https://pay.google.com"), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://book.motive11.com https://js.stripe.com https://*.js.stripe.com https://cdn.usefathom.com https://static.cloudflareinsights.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://cdn.usefathom.com; font-src 'self' data:; media-src 'self'; connect-src 'self' https://cdn.usefathom.com https://cloudflareinsights.com https://book.motive11.com https://api.stripe.com https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com https://js.stripe.com https://*.js.stripe.com https://hooks.stripe.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

# Hashed filenames: the bytes can never change under the same name, so immutable is honest here only.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
